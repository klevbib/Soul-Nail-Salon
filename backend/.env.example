# Copy this file to `.env` and fill in real values for anything you enable.
# For local development the defaults below are enough to run the core booking API.

# ---- Core ----
# Local dev uses SQLite (a file). In production, point this at Postgres, e.g.
#   DATABASE_URL="postgresql://user:pass@host:5432/soulnails"
DATABASE_URL="file:./dev.db"

# Port the API listens on.
PORT=4000

# Comma-separated list of origins allowed to call the API (the static frontend).
CORS_ORIGIN="http://localhost:8000,http://127.0.0.1:8000"

# Minimum minutes between "now" and the earliest bookable slot.
MIN_LEAD_MINUTES=60
# Slot granularity in minutes.
SLOT_GRANULARITY_MINUTES=15

# ---- Stripe (Phase 3 — deposits). Leave blank to disable payments. ----
# With STRIPE_SECRET_KEY blank, bookings confirm instantly and no card is taken.
# Set it (use a test-mode sk_test_… key) to switch on the £-deposit flow.
STRIPE_SECRET_KEY=""
# From `stripe listen` (dev) or the Dashboard webhook endpoint (prod).
STRIPE_WEBHOOK_SECRET=""
# Publishable key (pk_test_… / pk_live_…). Sent to the browser to load Stripe.js.
STRIPE_PUBLISHABLE_KEY=""

# ---- Email (Phase 4 — Resend). Leave blank to disable email. ----
RESEND_API_KEY=""
FROM_EMAIL="bookings@soulnailsalon.example"

# ---- SMS (Phase 4 — Twilio). Leave blank to disable SMS. ----
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_FROM_NUMBER=""

# ---- Admin dashboard (Phase 5) ----
# The dashboard fails closed: it is inaccessible until BOTH values below are set.
# Generate them with:  npm run admin:hash -- "your-strong-password"
# (prints an ADMIN_PASSWORD_HASH line and a suggested SESSION_SECRET).
#
# scrypt hash of the admin password — the plaintext is never stored.
ADMIN_PASSWORD_HASH=""
# Random secret used to sign session cookies. Rotating it logs everyone out.
SESSION_SECRET=""
# Optional: how long a login stays valid (hours) before re-login. Default 12.
# ADMIN_SESSION_HOURS=12

# ---- Stale-pending reaper (Phase 5, deposits only) ----
# Cancel a 'pending' booking (deposit never completed) after this many minutes,
# freeing its held slot. Only runs when Stripe deposits are enabled.
# PENDING_HOLD_MINUTES=30
# REAPER_SWEEP_MINUTES=10
