# Copy this file to `.env` and fill in real values for anything you enable.
# For local development the defaults below are enough to run the core booking API.

# ---- Core ----
# Local dev uses SQLite (a file). In production, point this at Postgres, e.g.
#   DATABASE_URL="postgresql://user:pass@host:5432/soulnails"
DATABASE_URL="file:./dev.db"

# Port the API listens on.
PORT=4000

# Comma-separated list of origins allowed to call the API (the static frontend).
CORS_ORIGIN="http://localhost:8000,http://127.0.0.1:8000"

# Minimum minutes between "now" and the earliest bookable slot.
MIN_LEAD_MINUTES=60
# Slot granularity in minutes.
SLOT_GRANULARITY_MINUTES=15

# ---- Stripe (Phase 3 — deposits). Leave blank to disable payments. ----
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""

# ---- Email (Phase 4 — Resend). Leave blank to disable email. ----
RESEND_API_KEY=""
FROM_EMAIL="bookings@soulnailsalon.example"

# ---- SMS (Phase 4 — Twilio). Leave blank to disable SMS. ----
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_FROM_NUMBER=""

# ---- Admin (Phase 5). Shared secret for the admin dashboard. ----
ADMIN_TOKEN="change-me-in-production"
